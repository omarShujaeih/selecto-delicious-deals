{
  "name": "Selecto",
  "short_name": "Selecto",
  "description": "Daily local food deals with cash payment on pickup.",
  "start_url": "/?source=pwa",
  "scope": "/",
  "display": "standalone",
  "display_override": [
    "standalone",
    "minimal-ui"
  ],
  "background_color": "#ffffff",
  "theme_color": "#123f32",
  "orientation": "portrait-primary",
  "dir": "rtl",
  "lang": "ar",
  "categories": [
    "food",
    "shopping",
    "lifestyle"
  ],
  "icons": [
    {
      "src": "../icons/icon-48.webp",
      "type": "image/png",
      "sizes": "48x48",
      "purpose": "any maskable"
    },
    {
